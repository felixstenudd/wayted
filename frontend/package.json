{
	"name": "wayted-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:panel": "vite --config vite.dev-panel.config.ts",
		"build": "vue-tsc --build && vite build",
		"build:panel": "vue-tsc --build && vite build --config vite.dev-panel.config.ts",
		"preview": "vite preview",
		"typecheck": "vue-tsc --build",
		"lint": "eslint . --cache --max-warnings 0",
		"lint:fix": "eslint . --cache --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@fontsource-variable/schibsted-grotesk": "^5.3.0",
		"@lucide/vue": "^1.48.0",
		"@tanstack/vue-query": "^5.103.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"pinia": "^4.0.3",
		"reka-ui": "^2.10.5",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"vue": "^3.5.43",
		"vue-i18n": "^11.4.12",
		"vue-router": "^5.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.2",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/test-utils": "^2.5.1",
		"eslint": "^10.11.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-boundaries": "^7.2.0",
		"eslint-plugin-vue": "^10.11.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.0",
		"prettier": "^3.9.8",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"vue-tsc": "^3.3.11"
	}
}
