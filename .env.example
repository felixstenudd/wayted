POSTGRES_USER=wayted
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wayted

# Passwords for the restricted database roles created on first start.
WAYTED_DOWNLOADER_PASSWORD=change-me
WAYTED_MAPPER_PASSWORD=change-me
WAYTED_API_PASSWORD=change-me

# Signs the API's access tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me

# Host port for the production frontend (nginx).
HTTP_PORT=80

# Host port for Postgres in development. Change it if a local Postgres already uses 5432.
DB_PORT=5432

# Base map of the dev panel: a MapLibre style document.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
